{
  "rules": [
    {
      "pattern": "(^|[^[:alnum:]_.-])rm[[:space:]]+([^;&|]*[[:space:]])?(-[a-z]*r[a-z]*|--recursive)([[:space:]\\\"']|$)",
      "message": "再帰的なrm（rm -rf, rm -fr, rm -r -f, --recursive など）は不可逆な削除です。対象と復旧手段を確認してから実行してください。",
      "enabled": true
    },
    {
      "pattern": "(^|[^[:alnum:]_.-])sudo([^[:alnum:]_.-]|$)",
      "message": "sudoによる特権操作です。必要性を確認してください。",
      "enabled": true
    },
    {
      "pattern": "git[[:space:]]+push([[:space:]]+[^;&|]*)?[[:space:]](--force([[:space:]=]|$)|--force-with-lease|-[a-z]*f[a-z]*([[:space:]]|$)|\\+[^[:space:]]+)",
      "message": "強制pushはリモート履歴を上書きします。上書き対象を確認してから実行してください。",
      "enabled": true
    },
    {
      "pattern": "git[[:space:]]+reset([[:space:]]+[^;&|]*)?[[:space:]]--hard",
      "message": "git reset --hardは未コミットの変更を破棄します。破棄内容を確認してから実行してください。",
      "enabled": true
    },
    {
      "pattern": "terraform[[:space:]]+([^;&|]*[[:space:]])?(destroy|apply)([[:space:]]|$)",
      "message": "terraformによるインフラの破棄・適用です。影響範囲を確認してから実行してください。",
      "enabled": true
    },
    {
      "pattern": "kubectl[[:space:]]+([^;&|]*[[:space:]])?delete([[:space:]]|$)",
      "message": "kubectlによるリソース削除です。対象と復旧手段を確認してから実行してください。",
      "enabled": true
    },
    {
      "pattern": "drop[[:space:]]+table",
      "message": "DROP TABLEはデータを不可逆に削除します。対象テーブルとバックアップの有無を確認してから実行してください。",
      "enabled": true
    },
    {
      "pattern": "truncate",
      "message": "TRUNCATEはデータを不可逆に削除します。対象とバックアップの有無を確認してから実行してください。",
      "enabled": true
    }
  ]
}
