{
  "description": "Global Codex lifecycle hooks managed by aicli-config-bridge.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /home/perso/.codex/hooks/rtk_pre_tool_use.py",
            "commandWindows": "node \"%USERPROFILE%\\.codex\\hooks\\rtk_pre_tool_use.mjs\"",
            "timeout": 30,
            "statusMessage": "Optimizing shell output with RTK"
          }
        ]
      }
    ]
  }
}
