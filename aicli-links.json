{
  "version": "0.2.0",
  "description": "AI CLI ツールの設定ファイルリンク構成",
  "links": [
    {
      "id": "claude-global-md",
      "name": "Claude グローバル設定 (CLAUDE.md)",
      "type": "file",
      "source": "project-configs/.claude/CLAUDE.md",
      "target": "~/.claude/CLAUDE.md",
      "target_windows": "%USERPROFILE%\\.claude\\CLAUDE.md",
      "create_if_missing": false
    },
    {
      "id": "codex-global-agents",
      "name": "Codex グローバル指示 (AGENTS.md)",
      "type": "file",
      "source": "project-configs/.codex/AGENTS.md",
      "target": "~/.codex/AGENTS.md",
      "target_windows": "%USERPROFILE%\\.codex\\AGENTS.md",
      "create_if_missing": false
    },
    {
      "id": "codex-global-hooks",
      "name": "Codex グローバルHook設定 (hooks.json)",
      "type": "file",
      "source": "project-configs/.codex/hooks.json",
      "target": "~/.codex/hooks.json",
      "target_windows": "%USERPROFILE%\\.codex\\hooks.json",
      "create_if_missing": false
    },
    {
      "id": "codex-rtk-hook-adapter",
      "name": "Codex RTK Hookアダプター",
      "type": "file",
      "source": "project-configs/.codex/hooks/rtk_pre_tool_use.py",
      "target": "~/.codex/hooks/rtk_pre_tool_use.py",
      "create_if_missing": false
    },
    {
      "id": "codex-rtk-hook-adapter-windows",
      "name": "Codex RTK Hookアダプター (Windows)",
      "type": "file",
      "source": "project-configs/.codex/hooks/rtk_pre_tool_use.mjs",
      "target": "~/.codex/hooks/rtk_pre_tool_use.mjs",
      "target_windows": "%USERPROFILE%\\.codex\\hooks\\rtk_pre_tool_use.mjs",
      "create_if_missing": false
    }
  ]
}
